{
	"name": "Evelyn's Pink",
	"colors": {
		// Global
		"focusBorder": "#F06292",
		"foreground": "#000000",
		"icon.foreground": "#880E4F",
		"disabledForeground": "#C2185B",
		"descriptionForeground": "#AD1457",
		"errorForeground": "#D32F2F",

		// Menüleiste & Titelleiste
		"titleBar.activeBackground": "#f48fb1",
		"titleBar.activeForeground": "#D50061",
		"titleBar.inactiveBackground": "#F06292",
		"titleBar.inactiveForeground": "#880E4F",

		// █████ Editor █████
		"editor.background": "#FEC2C8",
		"editor.foreground": "#880E4F",
		"editor.selectionBackground": "#F48FB1",
		"editor.selectionHighlightBackground": "#F8BBD080",
		"editor.lineHighlightBackground": "#FFFFFF33",
		"editor.lineHighlightBorder": "#F06292",
		"editorLineNumber.foreground": "#D50061",
		"editorBracketHighlight.foreground1": "#C2185B",
		"editorBracketHighlight.foreground2": "#AD1457",
		"editorBracketHighlight.foreground3": "#880E4F",
		"editorBracketHighlight.foreground4": "#6A0836",
		"editorBracketHighlight.foreground5": "#4A0526",
		"editorBracketHighlight.foreground6": "#2E0318",
		"editorError.foreground": "#D32F2F",
		"editorWarning.foreground": "#FF8F00",
		"editorGutter.addedBackground": "#4CAF50",
		"editorGutter.modifiedBackground": "#FFC107",
		"editorGutter.deletedBackground": "#F44336",
		"editorCursor.foreground": "#880E4F",
		"editor.wordHighlightBackground": "#00E5FF40",
		"editor.wordHighlightBorder": "#00E5FF",
		"editor.wordHighlightStrongBackground": "#1DE9B640",
		"editor.wordHighlightStrongBorder": "#1DE9B6",
		"editor.wordHighlightTextBackground": "#00E5FF40",
		"editor.wordHighlightTextBorder": "#00E5FF",
		"editorBracketMatch.background": "#00E5FF33",
		"editorBracketMatch.border": "#00E5FF",

		// █████ Suchbalken █████
		"editorWidget.background": "#F8BBD0",
		"editorWidget.foreground": "#000000",
		"input.background": "#F8BBD0",
		"input.foreground": "#000000",
		"inputOption.activeBorder": "#F06292",
		"inputValidation.infoBackground": "#F8BBD0",
		"inputValidation.warningBackground": "#FFF3E0",
		"inputValidation.errorBackground": "#FFCDD2",

		// █████ Breadcrumbs █████
		"breadcrumb.background": "#F8BBD0",
		"breadcrumb.foreground": "#880E4F",
		"breadcrumb.activeSelectionForeground": "#D50061",
		"breadcrumbPicker.background": "#ffffff",
		"breadcrumb.focusForeground": "#F06292",
		"editorGroupHeader.border": "#f18bb3",

		// █████ Terminal █████
		"terminal.background": "#F8BBD0",
		"terminal.foreground": "#000000",
		"terminalCursor.foreground": "#880E4F",
		"terminal.ansiBlack": "#F8BBD0",
		"terminal.ansiBrightBlack": "#A8677E",
		"terminal.ansiRed": "#F44336",
		"terminal.ansiBrightRed": "#C2185B",
		"terminal.ansiGreen": "#4CAF50",
		"terminal.ansiBrightGreen": "#2E7D32",
		"terminal.ansiYellow": "#8B6508",
		"terminal.ansiBrightYellow": "#B8860B",
		"terminal.ansiBlue": "#2196F3",
		"terminal.ansiBrightBlue": "#1565C0",
		"terminal.ansiMagenta": "#E91E63",
		"terminal.ansiBrightMagenta": "#AD1457",
		"terminal.ansiCyan": "#00BCD4",
		"terminal.ansiBrightCyan": "#00838F",
		"terminal.ansiWhite": "#000000",
		"terminal.ansiBrightWhite": "#000000",

		// █████ Panels █████
		"panel.background": "#F8BBD0",
		"panelTitle.activeForeground": "#D50061",
		"panelTitle.inactiveForeground": "#880E4F",
		"panelSectionHeader.background": "#F48FB1",
		"panelSectionHeader.foreground": "#000000",

		// █████ Source Control █████
		"gitDecoration.addedResourceForeground": "#4CAF50",
		"gitDecoration.modifiedResourceForeground": "#FFC107",
		"gitDecoration.deletedResourceForeground": "#F44336",

		// █████ Buttons & Controls █████
		"button.background": "#F06292",
		"button.foreground": "#000000",
		"button.secondaryBackground": "#F48FB1",
		"button.secondaryForeground": "#000000",
		"toolbar.hoverBackground": "#F8BBD0",

		// █████ Activity Bar █████
		"activityBar.background": "#F48FB1",
		"activityBar.foreground": "#000000",
		"activityBar.inactiveForeground": "#880E4F",
		"activityBarBadge.background": "#D50061",
		"activityBarBadge.foreground": "#000000",

		// █████ Sidebar & Explorer █████
		"sideBar.background": "#F8BBD0",
		"sideBar.foreground": "#000000",
		"sideBarSectionHeader.background": "#F48FB1",
		"sideBarSectionHeader.foreground": "#000000",
		"tree.indentGuidesStroke": "#D50061",
		"list.activeSelectionBackground": "#F48FB1",
		"list.hoverBackground": "#FCE4EC",
		"list.inactiveSelectionBackground": "#F8BBD0",

		// █████ Tabs █████
		"tab.activeBackground": "#FEC2C8",
		"tab.activeForeground": "#000000",
		"tab.inactiveBackground": "#F8BBD0",
		"tab.inactiveForeground": "#000000",
		"tab.border": "#F06292",
		"editorGroupHeader.tabsBackground": "#F8BBD0",
		"editorGroupHeader.tabsBorder": "#F06292",

		// █████ Menüs & Dropdowns █████
		"menu.background": "#F8BBD0",
		"menu.foreground": "#000000",
		"menu.selectionBackground": "#F48FB1",
		"menu.selectionForeground": "#000000",
		"menu.border": "#F06292",
		"dropdown.background": "#F8BBD0",
		"dropdown.foreground": "#000000",

		// █████ Status Bar █████
		"statusBar.background": "#F48FB1",
		"statusBar.foreground": "#000000",
		"statusBarItem.remoteBackground": "#F06292",
		"statusBarItem.remoteForeground": "#000000",

		// █████ Notebooks █████
		"notebook.cellEditorBackground": "#FEC2C8",
		"notebook.cellBorderColor": "#F06292",
		"notebook.focusedCellBorder": "#D50061",
		"notebook.inactiveFocusedCellBorder": "#F06292",
		"notebook.cellToolbarSeparator": "#F06292",
		"notebook.cellHoverBackground": "#ff9cbf",
		"notebookStatusSuccessIcon.foreground": "#4CAF50",
		"notebookStatusErrorIcon.foreground": "#D32F2F",
		"notebookStatusRunningIcon.foreground": "#880E4F"
	},
	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#C2185B",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Functions",
			"scope": ["entity.name.function", "meta.function-call"],
			"settings": {
				"foreground": "#D50061"
			}
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "storage.modifier"],
			"settings": {
				"foreground": "#AD1457",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.parameter"],
			"settings": {
				"foreground": "#D81B60"
			}
		},
		{
			"name": "Strings",
			"scope": ["string"],
			"settings": {
				"foreground": "#E91E63"
			}
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": {
				"foreground": "#EC407A"
			}
		},
		{
			"name": "Classes",
			"scope": ["entity.name.class", "entity.name.type.class"],
			"settings": {
				"foreground": "#AD1457",
				"fontStyle": "bold"
			}
		}
	]
}
